---
import Layout from '../../layouts/Layout.astro';
import Icons from '../../components/Icons.astro';
import { listPosts } from '../../lib/db';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const NEWS_POSTS = await listPosts(false);
const categories = ['All', 'Tour', 'Music', 'Band News', 'Solo / Press'] as const;
---

<Layout
  title="News"
  description="Official Skid Row news archive — 2027 tour dates, festival announcements, Justin Sargent & Won't Get Fooled Again, vinyl reissues, and band interviews."
>
  <section class="relative overflow-hidden border-b border-white/10 bg-obsidian pt-10 pb-16 sm:pt-16 sm:pb-20">
    <div class="crimson-glow pointer-events-none absolute inset-0" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="font-mono-meta text-xs tracking-[0.25em] text-crimson uppercase">
        Official Posts
      </p>
      <h1 class="font-display mt-1 text-5xl leading-none text-white uppercase sm:text-7xl">
        News
      </h1>
      <div class="slash-divider mt-4 w-28" />

      <!-- Search + Category Filter Bar -->
      <div class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="no-scrollbar flex gap-2 overflow-x-auto pb-1">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class:list={[
                'news-cat-btn min-h-11 shrink-0 border px-4 font-mono-meta text-xs font-bold tracking-wider uppercase transition-colors',
                idx === 0
                  ? 'border-crimson bg-crimson text-white'
                  : 'border-white/20 bg-coal text-ash hover:border-crimson hover:text-white',
              ]}
            >
              {cat}
            </button>
          ))}
        </div>

        <div class="relative w-full lg:w-80">
          <Icons
            name="search"
            class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-ash"
          />
          <input
            id="news-search"
            type="search"
            autocomplete="on"
            spellcheck="true"
            autocorrect="on"
            placeholder="Search tour, vinyl, Justin Sargent..."
            class="min-h-11 w-full border border-white/20 bg-coal pr-4 pl-10 text-sm text-white placeholder:text-ash/60 focus:border-crimson focus:outline-none"
          />
        </div>
      </div>

      <!-- News Grid -->
      <div id="news-grid" class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {NEWS_POSTS.map((post) => (
          <article
            class="news-card group flex flex-col border border-white/12 bg-coal transition-colors hover:border-crimson/70"
            data-category={post.category}
            data-search={`${post.title} ${post.excerpt} ${post.tags.join(' ')}`.toLowerCase()}
          >
            <a href={`/news/${post.slug}`} class="block overflow-hidden bg-black">
              <img
                src={post.image}
                alt={post.title}
                loading="lazy"
                decoding="async"
                class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </a>
            <div class="flex flex-1 flex-col p-5">
              <div class="font-mono-meta flex items-center justify-between text-[11px] tracking-wider uppercase">
                <span class="text-crimson">{post.category}</span>
                <span class="text-ash">{post.date}</span>
              </div>
              <h2 class="font-display mt-2 text-2xl leading-tight text-white uppercase transition-colors group-hover:text-crimson">
                <a href={`/news/${post.slug}`}>{post.title}</a>
              </h2>
              <p class="mt-2.5 line-clamp-3 flex-1 text-sm leading-relaxed text-ash">
                {post.excerpt}
              </p>
              <a
                href={`/news/${post.slug}`}
                class="font-mono-meta mt-4 inline-flex items-center gap-1.5 text-xs font-bold tracking-wider text-white uppercase transition-colors group-hover:text-crimson"
              >
                Read More
                <Icons name="arrow-right" class="h-3.5 w-3.5" />
              </a>
            </div>
          </article>
        ))}
      </div>

      <p
        id="news-empty"
        class="mt-10 hidden border border-white/10 bg-coal p-8 text-center font-mono-meta text-sm text-ash uppercase"
      >
        No matching posts found. Try a different keyword.
      </p>
    </div>
  </section>
</Layout>

<script>
  const catButtons = document.querySelectorAll<HTMLButtonElement>('.news-cat-btn');
  const searchInput = document.getElementById('news-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.news-card');
  const emptyMsg = document.getElementById('news-empty');

  let activeCat = 'All';

  function applyFilter() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const matchCat = activeCat === 'All' || card.dataset.category === activeCat;
      const matchQuery = !query || (card.dataset.search || '').includes(query);
      const show = matchCat && matchQuery;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    emptyMsg?.classList.toggle('hidden', visible > 0);
  }

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.category || 'All';
      catButtons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('bg-crimson', active);
        b.classList.toggle('border-crimson', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('bg-coal', !active);
        b.classList.toggle('border-white/20', !active);
        b.classList.toggle('text-ash', !active);
      });
      applyFilter();
    });
  });

  searchInput?.addEventListener('input', applyFilter);
</script>
