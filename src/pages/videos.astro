---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import Icons from '../components/Icons.astro';
import { VIDEOS } from '../data/videos';
import { SITE } from '../data/site';
import { buildVideosSchema } from '../lib/seo';

const featured = VIDEOS.find((v) => v.featured) ?? VIDEOS[0];
const rest = VIDEOS.filter((v) => v.id !== featured.id);
const youtubeChannel = SITE.socials.find((s) => s.id === 'youtube')?.url ?? '#';
const defaultCategory = 'Official Video';
const categories = [
  { value: 'Official Video', label: 'Official Videos' },
  { value: 'Live in London', label: 'Live in London' },
  { value: 'Lyric Video', label: 'Lyric Videos' },
  { value: 'Feature', label: 'Features' },
  { value: 'All', label: `All (${rest.length})` },
] as const;
---

<Layout
  title="Videos"
  description="Watch official Skid Row music videos, Live in London concert clips, and lyric videos from 2022 to 2026 including Won't Get Fooled Again, Resurrected, Time Bomb, Tear It Down, and The Gang's All Here."
  jsonLd={buildVideosSchema()}
>
  <section class="relative overflow-hidden border-b border-white/10 pt-10 pb-12 sm:pt-16 sm:pb-16">
    <div class="crimson-glow pointer-events-none absolute inset-0" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="font-mono-meta text-xs tracking-[0.25em] text-crimson uppercase">
            Official Channel • 2022 – 2026
          </p>
          <h1 class="font-display mt-1 text-5xl leading-none text-white uppercase sm:text-7xl">
            Videos
          </h1>
          <div class="slash-divider mt-4 w-28" />
        </div>
        <a
          href={youtubeChannel}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline w-full sm:w-auto"
        >
          <Icons name="youtube" class="h-5 w-5 text-crimson" />
          Subscribe on YouTube
        </a>
      </div>

      <!-- Featured Latest Video -->
      <div class="mt-8 border border-crimson/40 bg-coal p-3 sm:p-5">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <span class="font-mono-meta inline-flex items-center gap-2 bg-crimson px-2.5 py-1 text-[11px] font-bold tracking-widest text-white uppercase">
            Latest Release • {featured.year}
          </span>
          <span class="font-mono-meta text-xs text-ash uppercase">
            Tap to stream — zero bloat until played
          </span>
        </div>
        <YouTubeFacade
          videoId={featured.id}
          title={featured.title}
          subtitle="Play Official Music Video"
          thumbnail="/images/bio-wgfa.jpg"
        />
        <div class="mt-4 flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
          <div>
            <h2 class="font-display text-2xl text-white uppercase sm:text-3xl">
              {featured.title}
            </h2>
            <p class="mt-1 max-w-2xl text-sm text-ash">
              {featured.description}
            </p>
          </div>
          <a
            href="https://skidrow.lnk.to/WontGetFooledAgain"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-crimson shrink-0"
          >
            Stream Single
            <Icons name="external" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Video Vault With Category Filters -->
      <div class="mt-12">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <h2 class="font-display text-3xl text-white uppercase sm:text-4xl">
              Modern Era Vault
            </h2>
            <p class="font-mono-meta mt-1 text-xs text-ash uppercase">
              Music videos, Live in London &amp; lyric videos (2022–2026)
            </p>
          </div>
          <div class="no-scrollbar flex gap-2 overflow-x-auto pb-1">
            {categories.map((cat) => {
              const isDefault = cat.value === defaultCategory;
              return (
                <button
                  type="button"
                  data-vcat={cat.value}
                  class:list={[
                    'video-filter-btn min-h-10 shrink-0 border px-3.5 font-mono-meta text-xs font-bold tracking-wider uppercase transition-colors',
                    isDefault
                      ? 'border-crimson bg-crimson text-white'
                      : 'border-white/20 bg-coal text-ash hover:border-crimson hover:text-white',
                  ]}
                >
                  {cat.label}
                </button>
              );
            })}
          </div>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {rest.map((video) => (
            <article
              class:list={[
                'video-card flex flex-col border border-white/10 bg-coal transition-colors hover:border-crimson/60',
                video.category !== defaultCategory && 'hidden',
              ]}
              data-category={video.category}
            >
              <YouTubeFacade
                videoId={video.id}
                title={video.title}
                subtitle={`${video.category} • ${video.year}`}
              />
              <div class="flex flex-1 flex-col p-4">
                <div class="font-mono-meta flex items-center justify-between text-[11px] tracking-wider text-crimson uppercase">
                  <span>{video.category}</span>
                  <span class="text-ash">{video.year}</span>
                </div>
                <h3 class="font-display mt-1.5 text-xl text-white uppercase">
                  {video.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ash">
                  {video.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.video-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.video-card');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.vcat || 'All';
      btns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('bg-crimson', active);
        b.classList.toggle('border-crimson', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('bg-coal', !active);
        b.classList.toggle('border-white/20', !active);
        b.classList.toggle('text-ash', !active);
      });
      cards.forEach((c) => {
        const show = cat === 'All' || c.dataset.category === cat;
        c.classList.toggle('hidden', !show);
      });
    });
  });
</script>
