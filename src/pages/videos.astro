---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import Icons from '../components/Icons.astro';
import { VIDEOS } from '../data/videos';
import { SITE } from '../data/site';

const featured = VIDEOS.find((v) => v.featured) ?? VIDEOS[0];
const rest = VIDEOS.filter((v) => v.id !== featured.id);
const youtubeChannel = SITE.socials.find((s) => s.id === 'youtube')?.url ?? '#';
---

<Layout
  title="Videos"
  description="Watch official Skid Row music videos including Won't Get Fooled Again, The Gang's All Here, 18 and Life, Youth Gone Wild, I Remember You, and Slave to the Grind."
>
  <section class="relative overflow-hidden border-b border-white/10 pt-10 pb-12 sm:pt-16 sm:pb-16">
    <div class="crimson-glow pointer-events-none absolute inset-0" />
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="font-mono-meta text-xs tracking-[0.25em] text-crimson uppercase">
            Official Visuals
          </p>
          <h1 class="font-display mt-1 text-5xl leading-none text-white uppercase sm:text-7xl">
            Videos
          </h1>
          <div class="slash-divider mt-4 w-28" />
        </div>
        <a
          href={youtubeChannel}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline w-full sm:w-auto"
        >
          <Icons name="youtube" class="h-5 w-5 text-crimson" />
          Subscribe on YouTube
        </a>
      </div>

      <!-- Featured Latest Video -->
      <div class="mt-8 border border-crimson/40 bg-coal p-3 sm:p-5">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <span class="font-mono-meta inline-flex items-center gap-2 bg-crimson px-2.5 py-1 text-[11px] font-bold tracking-widest text-white uppercase">
            Latest Release • {featured.year}
          </span>
          <span class="font-mono-meta text-xs text-ash uppercase">
            Tap to stream — zero bloat until played
          </span>
        </div>
        <YouTubeFacade
          videoId={featured.id}
          title={featured.title}
          subtitle="Play Official Music Video"
          thumbnail="/images/bio-wgfa.jpg"
        />
        <div class="mt-4 flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
          <div>
            <h2 class="font-display text-2xl text-white uppercase sm:text-3xl">
              {featured.title}
            </h2>
            <p class="mt-1 max-w-2xl text-sm text-ash">
              {featured.description}
            </p>
          </div>
          <a
            href="https://skidrow.lnk.to/WontGetFooledAgain"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-crimson shrink-0"
          >
            Stream Single
            <Icons name="external" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <!-- Full Video Vault -->
      <div class="mt-12">
        <div class="mb-6 flex items-center justify-between">
          <h2 class="font-display text-3xl text-white uppercase sm:text-4xl">
            Video Vault
          </h2>
          <span class="font-mono-meta text-xs text-ash uppercase">
            {rest.length} Official Videos
          </span>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {rest.map((video) => (
            <article class="flex flex-col border border-white/10 bg-coal transition-colors hover:border-crimson/60">
              <YouTubeFacade
                videoId={video.id}
                title={video.title}
                subtitle={`${video.category} • ${video.year}`}
              />
              <div class="flex flex-1 flex-col p-4">
                <div class="font-mono-meta flex items-center justify-between text-[11px] tracking-wider text-crimson uppercase">
                  <span>{video.category}</span>
                  <span class="text-ash">{video.year}</span>
                </div>
                <h3 class="font-display mt-1.5 text-xl text-white uppercase">
                  {video.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ash">
                  {video.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
