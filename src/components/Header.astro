---
import { SITE } from '../data/site';
import Icons from './Icons.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-obsidian/92 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:h-20 lg:px-8">
    <!-- Brand Wordmark -->
    <a
      href="/"
      class="group flex items-center gap-2 focus:outline-none"
      aria-label="Skid Row Home"
    >
      <img
        src="/images/skidrow-logo.avif"
        alt="Skid Row"
        width="144"
        height="40"
        class="h-8 w-auto transition-transform duration-200 group-hover:scale-105 sm:h-10"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Primary" class="hidden items-center gap-0.5 lg:flex">
      {SITE.nav.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          class:list={[
            'font-display relative inline-flex items-center gap-1 px-2.5 py-2 text-[15px] tracking-wider uppercase transition-colors xl:px-3',
            !item.external && isActive(item.href)
              ? 'text-crimson'
              : 'text-chalk/85 hover:text-white',
          ]}
        >
          {item.label}
          {item.external && <Icons name="external" class="h-3 w-3 text-crimson" />}
          {!item.external && isActive(item.href) && (
            <span class="absolute right-2.5 bottom-0 left-2.5 h-0.5 bg-crimson" />
          )}
        </a>
      ))}
    </nav>

    <!-- Desktop Social Strip (All 8 Official Links) + Tour CTA -->
    <div class="hidden items-center gap-3.5 lg:flex">
      <div class="flex items-center gap-2 border-r border-white/15 pr-3.5">
        {SITE.socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.name}
            title={s.name}
            class="text-ash transition-colors hover:text-crimson"
          >
            <Icons name={s.id} class="h-4 w-4" />
          </a>
        ))}
      </div>
      <a
        href="/tour"
        class="btn-crimson !min-h-10 !px-3.5 !py-2 text-sm"
      >
        <Icons name="ticket" class="h-4 w-4" />
        2027 Tour
      </a>
    </div>

    <!-- Mobile Quick Actions -->
    <div class="flex items-center gap-2.5 lg:hidden">
      <a
        href="/tour"
        class="inline-flex min-h-10 items-center gap-1.5 bg-crimson px-3 py-1.5 font-display text-sm tracking-wider text-white uppercase active:scale-95"
      >
        <Icons name="ticket" class="h-3.5 w-3.5" />
        Tour
      </a>
      <button
        id="mobile-menu-open"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="inline-flex h-11 w-11 items-center justify-center border border-white/20 bg-coal text-white transition-colors hover:border-crimson active:scale-95"
      >
        <Icons name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>
</header>

<!-- Full-Screen Mobile Drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-[60] hidden flex-col bg-obsidian/98 backdrop-blur-xl"
  aria-hidden="true"
>
  <div class="flex h-16 items-center justify-between border-b border-white/10 px-4">
    <a href="/" class="flex items-center" aria-label="Skid Row Home">
      <img
        src="/images/skidrow-logo.avif"
        alt="Skid Row"
        width="144"
        height="40"
        class="h-8 w-auto"
      />
    </a>
    <button
      id="mobile-menu-close"
      type="button"
      aria-label="Close menu"
      class="inline-flex h-11 w-11 items-center justify-center border border-crimson bg-crimson/15 text-white active:scale-95"
    >
      <Icons name="close" class="h-6 w-6" />
    </button>
  </div>

  <nav
    aria-label="Mobile navigation"
    class="flex flex-1 flex-col justify-center gap-0.5 overflow-y-auto px-6 py-4"
  >
    {SITE.nav.map((item, idx) => (
      <a
        href={item.href}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener noreferrer' : undefined}
        class:list={[
          'group flex items-baseline justify-between border-b border-white/10 py-3 font-display text-3xl tracking-wider uppercase transition-colors sm:text-4xl',
          !item.external && isActive(item.href)
            ? 'text-crimson'
            : 'text-white hover:text-crimson',
        ]}
      >
        <span class="inline-flex items-center gap-2">
          {item.label}
          {item.external && <Icons name="external" class="h-4 w-4 text-crimson" />}
        </span>
        <span class="font-mono-meta text-xs text-ash group-hover:text-crimson">
          0{idx + 1}
        </span>
      </a>
    ))}
  </nav>

  <div class="border-t border-white/10 bg-coal px-6 py-5">
    <p class="font-mono-meta mb-3 text-[11px] tracking-[0.2em] text-ash uppercase">
      Follow &amp; Stream Skid Row
    </p>
    <div class="grid grid-cols-4 gap-3">
      {SITE.socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.name}
          class="flex h-11 items-center justify-center border border-white/15 bg-asphalt text-white transition-colors hover:border-crimson hover:text-crimson"
        >
          <Icons name={s.id} class="h-5 w-5" />
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-drawer');

  function setDrawer(open: boolean) {
    if (!drawer || !openBtn) return;
    drawer.classList.toggle('hidden', !open);
    drawer.classList.toggle('flex', open);
    drawer.setAttribute('aria-hidden', String(!open));
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  openBtn?.addEventListener('click', () => setDrawer(true));
  closeBtn?.addEventListener('click', () => setDrawer(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setDrawer(false);
  });
</script>
