---
import { BOOMBOX_ERAS, BOOMBOX_TRACKS } from '../data/boomboxTracks';
import Icons from './Icons.astro';

interface Props {
  compactHeading?: boolean;
}

const { compactHeading = false } = Astro.props;
const tracksJson = JSON.stringify(BOOMBOX_TRACKS);
---

<section
  class="bb-root relative overflow-hidden border-y border-white/10 bg-[#000000] py-8 sm:py-12 lg:py-14"
  data-tracks={tracksJson}
>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_35%,rgba(226,28,33,0.16)_0%,transparent_65%)]" />

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center">
      <div class="dymo-label">
        <span class="dymo-text text-[9.5px] sm:text-xs">
          1989 – 2026 • ALL ERAS BOOMBOX MIX
        </span>
      </div>
      <h2
        class:list={[
          'font-display mt-3 leading-none text-white uppercase',
          compactHeading ? 'text-3xl sm:text-5xl' : 'text-3xl sm:text-6xl',
        ]}
      >
        Crank Up <span class="text-crimson">Four Decades</span>
      </h2>
      <p class="mt-2 max-w-xl text-xs text-ash sm:text-base">
        Tap a cassette deck, filter by era, or scrub the radio dial—streaming straight from Skid Row's official YouTube vault.
      </p>
    </div>

    <!-- Era Cassette Filter Grid (Stacked 1 + 2x2 on Mobile, Centered Row on Desktop) -->
    <div class="mt-5 grid grid-cols-2 gap-1.5 sm:mt-7 sm:flex sm:flex-wrap sm:justify-center sm:gap-2">
      {BOOMBOX_ERAS.map((era, idx) => (
        <button
          type="button"
          data-bb-era={era.key}
          class:list={[
            'bb-era-btn group flex min-h-11 flex-col justify-center border px-3 py-1.5 text-left transition-all sm:shrink-0 sm:px-3.5',
            idx === 0
              ? 'col-span-2 items-center border-crimson bg-crimson text-center text-white shadow-[0_0_20px_rgba(226,28,33,0.4)] sm:col-span-1 sm:items-start sm:text-left'
              : 'items-start border-white/15 bg-coal text-ash hover:border-crimson/70 hover:text-white',
          ]}
        >
          <span class="font-mono-meta text-[10px] font-bold tracking-wider uppercase sm:text-[11px]">
            {era.label}
          </span>
          <span class="font-mono-meta text-[8.5px] tracking-wider opacity-80 uppercase sm:text-[9px] sm:tracking-widest">
            {era.sub} · {era.deckHint}
          </span>
        </button>
      ))}
    </div>

    <!-- ==================== INTERACTIVE 1980s BOOMBOX STAGE ==================== -->
    <div class="relative mx-auto mt-3 w-full max-w-4xl select-none">
      <!-- Full-bleed edge-to-edge boombox on narrow mobile + crop unused black air above handle -->
      <div class="-mx-3 overflow-hidden sm:mx-0">
        <div
          class="bb-stage relative -mt-[17%] -mb-[4%] aspect-[3/2] w-full overflow-hidden bg-black"
          data-playing="false"
        >
          <!-- Paid Adobe Stock 1980s Boombox Hardware Photo -->
          <img
            src="/images/boombox-1980s.jpg"
            alt="Interactive 1980s Skid Row Boombox"
            width="1024"
            height="682"
            loading="eager"
            decoding="async"
            class="h-full w-full object-contain"
          />

          <!-- Left & Right Chrome Woofer Bass Pulse Halos -->
          <div
            class="bb-woofer bb-woofer-l pointer-events-none absolute rounded-full border border-cyan-400/0 transition-transform duration-75"
            style="left: 9.0%; top: 53.6%; width: 19.3%; height: 29.2%;"
          ></div>
          <div
            class="bb-woofer bb-woofer-r pointer-events-none absolute rounded-full border border-crimson/0 transition-transform duration-75"
            style="left: 71.5%; top: 53.6%; width: 19.3%; height: 29.2%;"
          ></div>

          <!-- Left & Right Orange Tweeter Subtle Glows -->
          <div
            class="bb-tweeter pointer-events-none absolute rounded-full opacity-0 transition-opacity duration-300"
            style="left: 10.1%; top: 41.8%; width: 5.5%; height: 8.2%; background: radial-gradient(circle, rgba(255,95,31,0.55) 0%, transparent 72%);"
          ></div>
          <div
            class="bb-tweeter pointer-events-none absolute rounded-full opacity-0 transition-opacity duration-300"
            style="left: 84.2%; top: 41.8%; width: 5.5%; height: 8.2%; background: radial-gradient(circle, rgba(255,95,31,0.55) 0%, transparent 72%);"
          ></div>

          <!-- TOP TUNING DIAL: Real Scrub Bar + Gliding Crimson LED Needle -->
          <div
            class="bb-tuner-scrub group absolute cursor-pointer"
            style="left: 36.2%; top: 40.0%; width: 22.8%; height: 6.4%;"
            title="Click across Tuning Dial to seek track"
          >
            <div class="bb-tuner-glow pointer-events-none absolute inset-0 bg-cyan-400/10 opacity-0 transition-opacity group-hover:opacity-100"></div>
            <div
              class="bb-tuner-needle pointer-events-none absolute top-0 bottom-0 w-[3px] -translate-x-1/2 bg-crimson shadow-[0_0_10px_#ff262c,0_0_4px_#fff]"
              style="left: 0%;"
            ></div>
          </div>

          <!-- 16-SEGMENT PEAK-HOLD VU / SOUND LEVEL METER (Above Tape 1) -->
          <canvas
            class="bb-vu-canvas pointer-events-none absolute rounded-[1px]"
            width="200"
            height="32"
            style="left: 52.0%; top: 57.6%; width: 12.7%; height: 3.0%;"
          ></canvas>

          <!-- TAPE 2 WINDOW (BLUE — Classic Vault 1989–2014) + Spinning Cassette Reels -->
          <div
            class="bb-deck bb-deck-tape2 absolute cursor-pointer overflow-hidden rounded-[2px] transition-all duration-300"
            style="left: 34.4%; top: 62.6%; width: 14.5%; height: 11.4%;"
            title="Tape 2 — Play Classic Vault (1989–2014)"
          >
            <div class="bb-deck-glow pointer-events-none absolute inset-0 bg-cyan-400/0 transition-all duration-300"></div>
            <svg
              viewBox="0 0 40 40"
              class="bb-reel bb-reel-tape2 pointer-events-none absolute text-cyan-200/80"
              style="left: 31%; top: 43%; width: 20%; height: 32%;"
            >
              <circle cx="20" cy="20" r="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-dasharray="5 4" />
              <circle cx="20" cy="20" r="5" fill="currentColor" />
              <line x1="20" y1="6" x2="20" y2="34" stroke="currentColor" stroke-width="2" />
              <line x1="6" y1="20" x2="34" y2="20" stroke="currentColor" stroke-width="2" />
            </svg>
            <svg
              viewBox="0 0 40 40"
              class="bb-reel bb-reel-tape2 pointer-events-none absolute text-cyan-200/80"
              style="left: 55%; top: 43%; width: 20%; height: 32%;"
            >
              <circle cx="20" cy="20" r="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-dasharray="5 4" />
              <circle cx="20" cy="20" r="5" fill="currentColor" />
              <line x1="20" y1="6" x2="20" y2="34" stroke="currentColor" stroke-width="2" />
              <line x1="6" y1="20" x2="34" y2="20" stroke="currentColor" stroke-width="2" />
            </svg>
          </div>

          <!-- TAPE 1 WINDOW (RED — Modern & 2026 New Era) + Spinning Cassette Reels -->
          <div
            class="bb-deck bb-deck-tape1 absolute cursor-pointer overflow-hidden rounded-[2px] transition-all duration-300"
            style="left: 49.9%; top: 62.6%; width: 14.5%; height: 11.4%;"
            title="Tape 1 — Play Modern & 2026 New Era"
          >
            <div class="bb-deck-glow pointer-events-none absolute inset-0 bg-crimson/0 transition-all duration-300"></div>
            <svg
              viewBox="0 0 40 40"
              class="bb-reel bb-reel-tape1 pointer-events-none absolute text-rose-200/85"
              style="left: 29%; top: 43%; width: 20%; height: 32%;"
            >
              <circle cx="20" cy="20" r="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-dasharray="5 4" />
              <circle cx="20" cy="20" r="5" fill="currentColor" />
              <line x1="20" y1="6" x2="20" y2="34" stroke="currentColor" stroke-width="2" />
              <line x1="6" y1="20" x2="34" y2="20" stroke="currentColor" stroke-width="2" />
            </svg>
            <svg
              viewBox="0 0 40 40"
              class="bb-reel bb-reel-tape1 pointer-events-none absolute text-rose-200/85"
              style="left: 53%; top: 43%; width: 20%; height: 32%;"
            >
              <circle cx="20" cy="20" r="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-dasharray="5 4" />
              <circle cx="20" cy="20" r="5" fill="currentColor" />
              <line x1="20" y1="6" x2="20" y2="34" stroke="currentColor" stroke-width="2" />
              <line x1="6" y1="20" x2="34" y2="20" stroke="currentColor" stroke-width="2" />
            </svg>
          </div>

          <!-- First-Visit Tap-to-Play Callout Over Center Deck -->
          <button
            type="button"
            data-bb-act="play"
            class="bb-start-pill absolute top-[68%] left-1/2 z-10 flex -translate-x-1/2 -translate-y-1/2 items-center gap-1.5 border border-crimson bg-black/90 px-3 py-1.5 font-display text-xs tracking-widest whitespace-nowrap text-white uppercase shadow-[0_0_24px_rgba(226,28,33,0.75)] backdrop-blur-sm transition-all hover:scale-105 hover:bg-crimson sm:gap-2 sm:px-5 sm:py-2.5 sm:text-base"
          >
            <span class="h-2 w-2 animate-pulse rounded-full bg-crimson sm:h-2.5 sm:w-2.5"></span>
            Tap to Crank It Up
          </button>
        </div>
      </div>

      <!-- ==================== LIVE 32-BAND SPECTRUM GRAPH & DIGITAL DECK ==================== -->
      <div class="mt-2 border border-white/15 bg-coal/95 shadow-2xl">
        <!-- High-Res Live 32-Band Canvas Visualizer -->
        <div class="relative border-b border-white/10 bg-[#040406] px-3 pt-2.5 pb-2 sm:px-5 sm:pt-3">
          <div class="mb-2 flex items-center justify-between gap-2">
            <div class="flex min-w-0 items-center gap-2">
              <span class="bb-live-dot h-2 w-2 shrink-0 rounded-full bg-ash sm:h-2.5 sm:w-2.5"></span>
              <span class="bb-status-text truncate font-mono-meta text-[9px] font-bold tracking-[0.16em] text-ash uppercase sm:text-[10px] sm:tracking-[0.22em]">
                Standby • Ready to Play
              </span>
            </div>
            <span class="shrink-0 font-mono-meta text-[9px] tracking-widest text-ash/70 uppercase">
              Official YouTube Audio
            </span>
          </div>

          <canvas
            class="bb-main-spectrum block h-14 w-full sm:h-20"
            width="880"
            height="100"
          ></canvas>
        </div>

        <!-- Now Playing Readout + Thumb-Friendly Mobile & Desktop Controls -->
        <div class="grid grid-cols-1 items-center gap-3.5 p-3.5 sm:gap-4 sm:p-5 lg:grid-cols-12">
          <!-- Track Info -->
          <div class="flex items-center gap-3 lg:col-span-5">
            <img
              class="bb-cover h-12 w-12 shrink-0 border border-white/20 object-cover sm:h-16 sm:w-16"
              src={BOOMBOX_TRACKS[0].cover}
              alt={BOOMBOX_TRACKS[0].title}
            />
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="bb-era-badge font-mono-meta bg-crimson/20 px-1.5 py-0.5 text-[9px] font-bold tracking-wider text-crimson uppercase sm:text-[10px]">
                  {BOOMBOX_TRACKS[0].eraLabel}
                </span>
                <span class="bb-deck-badge font-mono-meta text-[9px] text-cyan-300 uppercase sm:text-[10px]">
                  TAPE 1
                </span>
              </div>
              <h3 class="bb-track-title font-display mt-0.5 truncate text-lg text-white uppercase sm:mt-1 sm:text-2xl">
                {BOOMBOX_TRACKS[0].title}
              </h3>
              <p class="bb-track-album truncate font-mono-meta text-[10px] text-ash sm:text-[11px]">
                {BOOMBOX_TRACKS[0].album} ({BOOMBOX_TRACKS[0].year})
              </p>
            </div>
          </div>

          <!-- Tactile Transport Controls + Scrub Progress -->
          <div class="flex flex-col gap-2.5 lg:col-span-4">
            <div class="grid grid-cols-[44px_44px_1fr_44px_44px] items-center gap-1.5 sm:flex sm:items-center sm:justify-center sm:gap-2">
              <button
                type="button"
                data-bb-act="shuffle"
                aria-label="Shuffle"
                class="bb-btn-shuffle flex h-11 w-11 items-center justify-center border border-white/15 bg-obsidian font-mono-meta text-[10px] text-ash transition-colors hover:border-cyan-400 hover:text-cyan-300 sm:text-xs"
                title="Toggle Shuffle Mix"
              >
                SHF
              </button>
              <button
                type="button"
                data-bb-act="prev"
                aria-label="Previous"
                class="flex h-11 w-11 items-center justify-center border border-white/15 bg-obsidian font-mono-meta text-sm text-white transition-colors hover:border-crimson hover:text-crimson"
              >
                &laquo;
              </button>
              <button
                type="button"
                data-bb-act="play"
                aria-label="Play or Pause"
                class="bb-btn-play flex h-11 w-full items-center justify-center gap-1.5 border border-crimson bg-crimson px-4 font-display text-base tracking-wider text-white uppercase shadow-[0_0_20px_rgba(226,28,33,0.45)] transition-all hover:bg-crimson-bright active:scale-95 sm:h-12 sm:w-auto sm:min-w-28"
              >
                <Icons name="play" class="h-4 w-4" />
                <span class="bb-play-label">Play</span>
              </button>
              <button
                type="button"
                data-bb-act="next"
                aria-label="Next"
                class="flex h-11 w-11 items-center justify-center border border-white/15 bg-obsidian font-mono-meta text-sm text-white transition-colors hover:border-crimson hover:text-crimson"
              >
                &raquo;
              </button>
              <button
                type="button"
                data-bb-act="stop"
                aria-label="Stop"
                class="flex h-11 w-11 items-center justify-center border border-white/15 bg-obsidian font-mono-meta text-xs text-ash transition-colors hover:border-crimson hover:text-white"
                title="Stop"
              >
                &#9632;
              </button>
            </div>

            <!-- Interactive Progress Bar -->
            <div class="flex items-center gap-2 font-mono-meta text-[10px] text-ash">
              <span class="bb-time-cur w-9 text-right">0:00</span>
              <div class="bb-progress-bar relative h-2.5 flex-1 cursor-pointer border border-white/10 bg-obsidian">
                <div class="bb-progress-fill h-full w-0 bg-gradient-to-r from-cyan-400 via-crimson to-crimson-bright transition-[width] duration-150"></div>
              </div>
              <span class="bb-time-dur w-9">0:00</span>
            </div>
          </div>

          <!-- Real Volume Slider + Video Deck Toggle -->
          <div class="flex flex-wrap items-center justify-between gap-3 lg:col-span-3 lg:justify-end">
            <label class="flex flex-1 items-center gap-2 sm:flex-initial">
              <span class="font-mono-meta text-[10px] text-ash uppercase">Vol</span>
              <input
                type="range"
                min="0"
                max="100"
                value="85"
                aria-label="Volume"
                class="bb-vol-slider h-1.5 w-24 cursor-pointer accent-crimson"
              />
              <span class="bb-vol-val w-8 font-mono-meta text-[10px] text-chalk">85%</span>
            </label>
            <button
              type="button"
              class="bb-toggle-video border border-white/20 bg-obsidian px-2.5 py-2 font-mono-meta text-[10px] font-bold tracking-wider text-chalk uppercase transition-colors hover:border-crimson hover:text-crimson"
            >
              Show Video
            </button>
          </div>
        </div>

        <!-- Tracklist + Collapsible Official YouTube Feed (collapsed when no video is showing) -->
        <div class="grid grid-cols-1 border-t border-white/10 lg:grid-cols-12">
          <div class="bb-tracklist-wrap max-h-64 divide-y divide-white/8 overflow-y-auto bg-obsidian/70 lg:col-span-12">
            <div class="bb-tracklist"></div>
          </div>

          <!-- Official YouTube Deck Monitor (collapsed until a video plays or user clicks Show Video) -->
          <div class="bb-video-panel pointer-events-none h-0 overflow-hidden bg-black p-0 opacity-0 transition-all duration-300">
            <div class="mb-2 flex items-center justify-between">
              <span class="font-mono-meta text-[10px] tracking-widest text-crimson uppercase">
                Official YouTube Feed
              </span>
              <span class="font-mono-meta text-[9px] text-ash uppercase">
                Licensed Stream
              </span>
            </div>
            <div class="relative aspect-video w-full overflow-hidden border border-white/15 bg-black">
              <div class="bb-yt-mount h-full w-full"></div>
            </div>
            <p class="mt-2 font-mono-meta text-[10px] text-ash/80">
              Streams directly from Skid Row's official YouTube catalog.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes bb-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .bb-stage[data-playing="true"] .bb-reel-active {
    animation: bb-spin 1.8s linear infinite;
  }
  .bb-stage[data-playing="true"] .bb-tweeter {
    opacity: 0.9;
  }
  @media (prefers-reduced-motion: reduce) {
    .bb-stage[data-playing="true"] .bb-reel-active {
      animation: none;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      YT?: any;
      onYouTubeIframeAPIReady?: () => void;
      __srYtReadyQueue?: Array<() => void>;
    }
  }

  function loadYouTubeAPI(cb: () => void) {
    if (window.YT && window.YT.Player) {
      cb();
      return;
    }
    window.__srYtReadyQueue = window.__srYtReadyQueue || [];
    window.__srYtReadyQueue.push(cb);

    if (!document.getElementById('sr-yt-iframe-api')) {
      const tag = document.createElement('script');
      tag.id = 'sr-yt-iframe-api';
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
      const prev = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        prev?.();
        (window.__srYtReadyQueue || []).forEach((fn) => fn());
        window.__srYtReadyQueue = [];
      };
    }
  }

  const ROCK_CURVE = [0.92, 0.78, 0.74, 0.88, 0.94];

  document.querySelectorAll<HTMLElement>('.bb-root').forEach((root, instanceIdx) => {
    if (root.dataset.initialized) return;
    root.dataset.initialized = 'true';

    const allTracks = JSON.parse(root.dataset.tracks || '[]');
    if (!allTracks.length) return;

    let activeEra = 'all';
    let filteredTracks = [...allTracks];
    let currentIdx = 0;
    let isPlaying = false;
    let isShuffle = false;
    let volume = 85;
    let ytPlayer: any = null;
    let ytReady = false;
    let pendingPlay = false;
    let rafId: number | null = null;

    const stage = root.querySelector<HTMLElement>('.bb-stage')!;
    const startPill = root.querySelector<HTMLElement>('.bb-start-pill');
    const tunerNeedle = root.querySelector<HTMLElement>('.bb-tuner-needle');
    const tunerScrub = root.querySelector<HTMLElement>('.bb-tuner-scrub');
    const deckTape1 = root.querySelector<HTMLElement>('.bb-deck-tape1');
    const deckTape2 = root.querySelector<HTMLElement>('.bb-deck-tape2');
    const reels1 = root.querySelectorAll<SVGElement>('.bb-reel-tape1');
    const reels2 = root.querySelectorAll<SVGElement>('.bb-reel-tape2');
    const wooferL = root.querySelector<HTMLElement>('.bb-woofer-l');
    const wooferR = root.querySelector<HTMLElement>('.bb-woofer-r');
    const volSlider = root.querySelector<HTMLInputElement>('.bb-vol-slider');
    const volVal = root.querySelector<HTMLElement>('.bb-vol-val');

    const mainCanvas = root.querySelector<HTMLCanvasElement>('.bb-main-spectrum')!;
    const vuCanvas = root.querySelector<HTMLCanvasElement>('.bb-vu-canvas')!;
    const mainCtx = mainCanvas.getContext('2d')!;
    const vuCtx = vuCanvas.getContext('2d')!;

    const liveDot = root.querySelector<HTMLElement>('.bb-live-dot');
    const statusText = root.querySelector<HTMLElement>('.bb-status-text');
    const coverImg = root.querySelector<HTMLImageElement>('.bb-cover');
    const eraBadge = root.querySelector<HTMLElement>('.bb-era-badge');
    const deckBadge = root.querySelector<HTMLElement>('.bb-deck-badge');
    const titleEl = root.querySelector<HTMLElement>('.bb-track-title');
    const albumEl = root.querySelector<HTMLElement>('.bb-track-album');
    const playLabel = root.querySelector<HTMLElement>('.bb-play-label');
    const shuffleBtns = root.querySelectorAll<HTMLElement>('[data-bb-act="shuffle"]');
    const curTimeEl = root.querySelector<HTMLElement>('.bb-time-cur');
    const durTimeEl = root.querySelector<HTMLElement>('.bb-time-dur');
    const progBar = root.querySelector<HTMLElement>('.bb-progress-bar');
    const progFill = root.querySelector<HTMLElement>('.bb-progress-fill');
    const tracklistEl = root.querySelector<HTMLElement>('.bb-tracklist')!;
    const tracklistWrap = root.querySelector<HTMLElement>('.bb-tracklist-wrap');
    const ytMount = root.querySelector<HTMLElement>('.bb-yt-mount')!;
    const videoPanel = root.querySelector<HTMLElement>('.bb-video-panel');
    const toggleVideoBtn = root.querySelector<HTMLElement>('.bb-toggle-video');
    let userVideoPref: boolean | null = null;

    function setVideoPanelOpen(open: boolean) {
      if (!videoPanel || !tracklistWrap) return;
      if (open) {
        tracklistWrap.classList.remove('lg:col-span-12');
        tracklistWrap.classList.add('lg:col-span-8');
        videoPanel.className =
          'bb-video-panel flex flex-col justify-between border-t border-white/10 bg-black p-3 opacity-100 transition-all duration-300 lg:col-span-4 lg:border-t-0 lg:border-l';
        if (toggleVideoBtn) toggleVideoBtn.textContent = 'Hide Video';
      } else {
        tracklistWrap.classList.remove('lg:col-span-8');
        tracklistWrap.classList.add('lg:col-span-12');
        videoPanel.className =
          'bb-video-panel pointer-events-none h-0 overflow-hidden bg-black p-0 opacity-0 transition-all duration-300';
        if (toggleVideoBtn) toggleVideoBtn.textContent = 'Show Video';
      }
    }

    function syncVideoPanelVisibility() {
      const t = currentTrack();
      if (userVideoPref !== null) {
        setVideoPanelOpen(userVideoPref);
        return;
      }
      setVideoPanelOpen(isPlaying && Boolean(t.isOfficialVideo));
    }

    const mountId = `sr-bb-yt-${instanceIdx}-${Math.random().toString(36).slice(2, 6)}`;
    ytMount.id = mountId;

    function currentTrack() {
      return filteredTracks[currentIdx] || filteredTracks[0] || allTracks[0];
    }

    function fmtTime(sec: number) {
      if (!Number.isFinite(sec) || sec < 0) return '0:00';
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return `${m}:${String(s).padStart(2, '0')}`;
    }

    function logBoomboxTelemetry(track: any) {
      try {
        const sid = sessionStorage.getItem('sr_sid') || 'bb_anon';
        const payload = JSON.stringify({
          sessionId: sid,
          eventType: 'video_play',
          path: window.location.pathname,
          targetLabel: `Boombox: ${track.title} (${track.year})`,
          targetUrl: `https://www.youtube.com/watch?v=${track.youtubeId}`,
          deviceType: window.innerWidth < 768 ? 'mobile' : 'desktop',
        });
        fetch('/api/pulse', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
          keepalive: true,
          credentials: 'same-origin',
        }).catch(() => {});
      } catch {}
    }

    function applyVolume(v: number) {
      volume = Math.max(0, Math.min(100, Math.round(v)));
      if (volSlider) volSlider.value = String(volume);
      if (volVal) volVal.textContent = `${volume}%`;
      if (ytPlayer && ytReady && typeof ytPlayer.setVolume === 'function') {
        ytPlayer.setVolume(volume);
      }
    }

    function updateDeckVisuals() {
      const t = currentTrack();
      stage.dataset.playing = String(isPlaying);
      startPill?.classList.toggle('hidden', isPlaying);

      const t1Active = t.deck === 'tape1';
      const t2Active = t.deck === 'tape2';

      deckTape1?.querySelector<HTMLElement>('.bb-deck-glow')?.classList.toggle('bg-crimson/20', t1Active && isPlaying);
      deckTape2?.querySelector<HTMLElement>('.bb-deck-glow')?.classList.toggle('bg-cyan-400/20', t2Active && isPlaying);
      deckTape1?.classList.toggle('ring-1', t1Active);
      deckTape1?.classList.toggle('ring-crimson/70', t1Active);
      deckTape2?.classList.toggle('ring-1', t2Active);
      deckTape2?.classList.toggle('ring-cyan-400/70', t2Active);

      reels1.forEach((r) => r.classList.toggle('bb-reel-active', t1Active && isPlaying));
      reels2.forEach((r) => r.classList.toggle('bb-reel-active', t2Active && isPlaying));

      if (liveDot) {
        liveDot.className = isPlaying
          ? 'bb-live-dot h-2.5 w-2.5 animate-pulse rounded-full bg-crimson shadow-[0_0_10px_#e21c21]'
          : 'bb-live-dot h-2.5 w-2.5 rounded-full bg-ash';
      }
      if (statusText) {
        statusText.textContent = isPlaying
          ? `On Air • ${t.deck === 'tape1' ? 'Tape 1 (Red)' : 'Tape 2 (Blue)'}`
          : 'Standby • Press Play to Stream';
      }
      if (playLabel) playLabel.textContent = isPlaying ? 'Pause' : 'Play';
      syncVideoPanelVisibility();
      syncVisualizerLoop();
    }

    function updateTrackUI() {
      const t = currentTrack();
      if (coverImg) {
        coverImg.src = t.cover;
        coverImg.alt = t.title;
      }
      if (eraBadge) eraBadge.textContent = t.eraLabel;
      if (deckBadge) {
        deckBadge.textContent = t.deck === 'tape1' ? 'TAPE 1 • RED' : 'TAPE 2 • BLUE';
        deckBadge.className =
          t.deck === 'tape1'
            ? 'bb-deck-badge font-mono-meta text-[10px] text-crimson uppercase'
            : 'bb-deck-badge font-mono-meta text-[10px] text-cyan-300 uppercase';
      }
      if (titleEl) titleEl.textContent = t.title;
      if (albumEl) albumEl.textContent = `${t.album} (${t.year})`;
      renderTracklist();
      updateDeckVisuals();
    }

    function renderTracklist() {
      const cur = currentTrack();
      tracklistEl.innerHTML = filteredTracks
        .map((t: any, i: number) => {
          const active = t.id === cur.id;
          return `<button type="button" data-bb-idx="${i}" class="flex w-full items-center justify-between gap-3 px-3.5 py-2.5 text-left transition-colors hover:bg-asphalt ${
            active ? 'border-l-2 border-crimson bg-asphalt' : ''
          }">
            <div class="flex min-w-0 items-center gap-3">
              <span class="font-mono-meta w-5 text-[10px] ${active ? 'font-bold text-crimson' : 'text-ash'}">
                ${active && isPlaying ? '▶' : String(i + 1).padStart(2, '0')}
              </span>
              <img src="${t.cover}" alt="" loading="lazy" class="h-9 w-9 shrink-0 border border-white/15 object-cover" />
              <div class="min-w-0">
                <p class="truncate font-display text-base uppercase ${active ? 'text-crimson' : 'text-white'}">${t.title}</p>
                <p class="truncate font-mono-meta text-[10px] text-ash">${t.album} · ${t.year}</p>
              </div>
            </div>
            <span class="shrink-0 font-mono-meta border px-1.5 py-0.5 text-[9px] uppercase ${
              t.deck === 'tape1'
                ? 'border-crimson/40 text-crimson'
                : 'border-cyan-400/40 text-cyan-300'
            }">
              ${t.deck === 'tape1' ? 'T1' : 'T2'}
            </span>
          </button>`;
        })
        .join('');

      tracklistEl.querySelectorAll<HTMLButtonElement>('[data-bb-idx]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.bbIdx || '0');
          playTrackAt(idx);
        });
      });
    }

    function ensurePlayer(autoplay = false) {
      if (ytPlayer) {
        if (autoplay && ytReady) ytPlayer.playVideo();
        return;
      }
      pendingPlay = autoplay;
      loadYouTubeAPI(() => {
        if (ytPlayer) return;
        const first = currentTrack();
        ytPlayer = new window.YT.Player(mountId, {
          videoId: first.youtubeId,
          playerVars: {
            autoplay: pendingPlay ? 1 : 0,
            controls: 1,
            modestbranding: 1,
            rel: 0,
            playsinline: 1,
            origin: window.location.origin,
          },
          events: {
            onReady: () => {
              ytReady = true;
              ytPlayer.setVolume(volume);
              if (pendingPlay) {
                pendingPlay = false;
                ytPlayer.playVideo();
              }
            },
            onStateChange: (ev: any) => {
              const YTState = window.YT.PlayerState;
              if (ev.data === YTState.PLAYING) {
                isPlaying = true;
                updateDeckVisuals();
                renderTracklist();
                logBoomboxTelemetry(currentTrack());
              } else if (ev.data === YTState.PAUSED) {
                isPlaying = false;
                updateDeckVisuals();
                renderTracklist();
              } else if (ev.data === YTState.ENDED) {
                nextTrack();
              }
            },
          },
        });
      });
    }

    function playTrackAt(idx: number) {
      currentIdx = (idx + filteredTracks.length) % filteredTracks.length;
      const t = currentTrack();
      updateTrackUI();
      if (ytPlayer && ytReady) {
        ytPlayer.loadVideoById(t.youtubeId);
        ytPlayer.setVolume(volume);
      } else {
        ensurePlayer(true);
      }
    }

    function togglePlay() {
      if (!ytPlayer || !ytReady) {
        ensurePlayer(true);
        return;
      }
      if (isPlaying) {
        ytPlayer.pauseVideo();
      } else {
        ytPlayer.playVideo();
      }
    }

    function stopPlayback() {
      if (ytPlayer && ytReady) {
        ytPlayer.stopVideo();
      }
      isPlaying = false;
      userVideoPref = null;
      if (progFill) progFill.style.width = '0%';
      if (tunerNeedle) tunerNeedle.style.left = '0%';
      if (curTimeEl) curTimeEl.textContent = '0:00';
      updateDeckVisuals();
      renderTracklist();
    }

    function nextTrack() {
      if (isShuffle && filteredTracks.length > 1) {
        let next = currentIdx;
        while (next === currentIdx) {
          next = Math.floor(Math.random() * filteredTracks.length);
        }
        playTrackAt(next);
      } else {
        playTrackAt(currentIdx + 1);
      }
    }

    function prevTrack() {
      playTrackAt(currentIdx - 1);
    }

    function seekToRatio(ratio: number) {
      if (!ytPlayer || !ytReady) return;
      const dur = ytPlayer.getDuration?.() || 0;
      if (dur > 0) {
        ytPlayer.seekTo(dur * Math.max(0, Math.min(1, ratio)), true);
      }
    }

    // Bind Era Filter Buttons
    root.querySelectorAll<HTMLButtonElement>('.bb-era-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeEra = btn.dataset.bbEra || 'all';
        root.querySelectorAll<HTMLButtonElement>('.bb-era-btn').forEach((b) => {
          const active = b === btn;
          b.classList.toggle('border-crimson', active);
          b.classList.toggle('bg-crimson', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('shadow-[0_0_20px_rgba(226,28,33,0.4)]', active);
          b.classList.toggle('border-white/15', !active);
          b.classList.toggle('bg-coal', !active);
          b.classList.toggle('text-ash', !active);
        });
        filteredTracks =
          activeEra === 'all'
            ? [...allTracks]
            : allTracks.filter((t: any) => t.era === activeEra);
        currentIdx = 0;
        if (isPlaying) {
          playTrackAt(0);
        } else {
          updateTrackUI();
          if (ytPlayer && ytReady) {
            ytPlayer.cueVideoById(currentTrack().youtubeId);
          }
        }
      });
    });

    // Bind Real Transport Controls
    root.querySelectorAll<HTMLElement>('[data-bb-act]').forEach((el) => {
      el.addEventListener('click', () => {
        const act = el.dataset.bbAct;
        if (act === 'play') togglePlay();
        else if (act === 'prev') prevTrack();
        else if (act === 'next') nextTrack();
        else if (act === 'stop') stopPlayback();
        else if (act === 'shuffle') {
          isShuffle = !isShuffle;
          shuffleBtns.forEach((b) => {
            b.classList.toggle('border-cyan-400', isShuffle);
            b.classList.toggle('text-cyan-300', isShuffle);
            b.classList.toggle('bg-cyan-400/20', isShuffle);
          });
        }
      });
    });

    // Clicking Tape 1 plays Modern/2026; Tape 2 plays Classic Vault
    deckTape1?.addEventListener('click', () => {
      if (isPlaying && currentTrack().deck === 'tape1') {
        togglePlay();
      } else {
        const idx = filteredTracks.findIndex((t: any) => t.deck === 'tape1');
        if (idx >= 0) playTrackAt(idx);
        else togglePlay();
      }
    });
    deckTape2?.addEventListener('click', () => {
      if (isPlaying && currentTrack().deck === 'tape2') {
        togglePlay();
      } else {
        const idx = filteredTracks.findIndex((t: any) => t.deck === 'tape2');
        if (idx >= 0) playTrackAt(idx);
        else togglePlay();
      }
    });

    volSlider?.addEventListener('input', () => applyVolume(Number(volSlider.value)));

    // Scrubbing on Progress Bar & Top FM Tuning Dial
    progBar?.addEventListener('click', (e) => {
      const rect = progBar.getBoundingClientRect();
      seekToRatio((e.clientX - rect.left) / rect.width);
    });
    tunerScrub?.addEventListener('click', (e) => {
      const rect = tunerScrub.getBoundingClientRect();
      seekToRatio((e.clientX - rect.left) / rect.width);
    });

    // Toggle Video Deck open/collapsed manually
    toggleVideoBtn?.addEventListener('click', () => {
      const currentlyOpen = toggleVideoBtn.textContent?.trim() === 'Hide Video';
      userVideoPref = !currentlyOpen;
      if (userVideoPref && !ytPlayer) {
        ensurePlayer(false);
      }
      setVideoPanelOpen(userVideoPref);
    });

    // ==================== ZERO-CPU IDLE + 60FPS ACTIVE SPECTRUM, VU & WOOFER PULSE ====================
    const BANDS = 32;
    const barVals = new Float32Array(BANDS);
    const barPeaks = new Float32Array(BANDS);
    let vuLevel = 0;
    let vuPeak = 0;
    let lastClockSync = 0;

    function drawStaticIdle() {
      const mw = mainCanvas.width;
      const mh = mainCanvas.height;
      mainCtx.clearRect(0, 0, mw, mh);

      mainCtx.strokeStyle = 'rgba(255,255,255,0.06)';
      mainCtx.lineWidth = 1;
      for (let g = 1; g <= 3; g++) {
        const gy = Math.round((mh / 4) * g) + 0.5;
        mainCtx.beginPath();
        mainCtx.moveTo(0, gy);
        mainCtx.lineTo(mw, gy);
        mainCtx.stroke();
      }

      const gap = 5;
      const bw = (mw - gap * (BANDS - 1)) / BANDS;
      for (let i = 0; i < BANDS; i++) {
        const x = i * (bw + gap);
        mainCtx.fillStyle = 'rgba(34, 211, 238, 0.35)';
        mainCtx.fillRect(x, mh - 4, bw, 4);
      }

      // Idle VU meter (dim unlit LEDs)
      vuCtx.clearRect(0, 0, vuCanvas.width, vuCanvas.height);
      const segs = 16;
      const segW = (vuCanvas.width - (segs - 1) * 3) / segs;
      for (let s = 0; s < segs; s++) {
        vuCtx.fillStyle = s === 0 ? 'rgba(34, 197, 94, 0.45)' : '#18181b';
        vuCtx.fillRect(s * (segW + 3), 4, segW, vuCanvas.height - 8);
      }

      if (wooferL && wooferR) {
        wooferL.style.transform = 'scale(1)';
        wooferR.style.transform = 'scale(1)';
        wooferL.style.boxShadow = 'none';
        wooferR.style.boxShadow = 'none';
      }
    }

    function animate(ts: number) {
      if (!isPlaying || document.hidden) {
        rafId = null;
        drawStaticIdle();
        return;
      }

      const t = currentTrack();
      const volFactor = Math.max(0.12, volume / 100);
      const bpmFreq = ((t.bpm || 130) / 60) * Math.PI * 2;
      const sec = ts / 1000;
      const beat = Math.pow(0.5 + 0.5 * Math.sin(sec * bpmFreq), 3);

      // Update YouTube elapsed clock every ~250ms
      if (ts - lastClockSync > 250) {
        lastClockSync = ts;
        if (ytPlayer && ytReady && typeof ytPlayer.getCurrentTime === 'function') {
          const cur = ytPlayer.getCurrentTime() || 0;
          const dur = ytPlayer.getDuration() || 0;
          if (curTimeEl) curTimeEl.textContent = fmtTime(cur);
          if (durTimeEl && dur > 0) durTimeEl.textContent = fmtTime(dur);
          if (dur > 0) {
            const pct = Math.min(100, (cur / dur) * 100);
            if (progFill) progFill.style.width = `${pct}%`;
            if (tunerNeedle) tunerNeedle.style.left = `${pct}%`;
          }
        }
      }

      // Compute 32 spectrum bands driven by BPM beat, track energy & volume
      let bassSum = 0;
      for (let i = 0; i < BANDS; i++) {
        const eqIdx = Math.min(4, Math.floor((i / BANDS) * 5));
        const eqWeight = ROCK_CURVE[eqIdx] ?? 0.75;
        const wave1 = 0.5 + 0.5 * Math.sin(sec * (5.2 + i * 0.45) + i * 0.9);
        const wave2 = 0.5 + 0.5 * Math.cos(sec * (8.5 + (BANDS - i) * 0.28) - i * 0.6);
        const bassBoost = i < 7 ? beat * 0.55 : beat * 0.2;
        const target = Math.min(
          1,
          (0.18 + wave1 * 0.42 + wave2 * 0.25 + bassBoost) * eqWeight * (t.energy || 0.9) * volFactor
        );
        barVals[i] += (target - barVals[i]) * 0.32;
        if (barVals[i] > barPeaks[i]) barPeaks[i] = barVals[i];
        else barPeaks[i] = Math.max(0, barPeaks[i] - 0.012);
        if (i < 6) bassSum += barVals[i];
      }

      // Draw Main 32-Band Spectrum Canvas
      const mw = mainCanvas.width;
      const mh = mainCanvas.height;
      mainCtx.clearRect(0, 0, mw, mh);

      mainCtx.strokeStyle = 'rgba(255,255,255,0.06)';
      mainCtx.lineWidth = 1;
      for (let g = 1; g <= 3; g++) {
        const gy = Math.round((mh / 4) * g) + 0.5;
        mainCtx.beginPath();
        mainCtx.moveTo(0, gy);
        mainCtx.lineTo(mw, gy);
        mainCtx.stroke();
      }

      const gap = 5;
      const bw = (mw - gap * (BANDS - 1)) / BANDS;
      for (let i = 0; i < BANDS; i++) {
        const x = i * (bw + gap);
        const h = Math.max(3, barVals[i] * (mh - 12));
        const grad = mainCtx.createLinearGradient(0, mh, 0, 0);
        grad.addColorStop(0, '#0891b2');
        grad.addColorStop(0.55, '#22d3ee');
        grad.addColorStop(0.78, '#e21c21');
        grad.addColorStop(1, '#ff3b41');
        mainCtx.fillStyle = grad;
        mainCtx.fillRect(x, mh - h, bw, h);

        const py = mh - Math.max(4, barPeaks[i] * (mh - 12)) - 3;
        mainCtx.fillStyle = barPeaks[i] > 0.72 ? '#ff262c' : '#e4e4e7';
        mainCtx.fillRect(x, py, bw, 2.5);
      }

      // Draw 16-Segment Peak-Hold VU Sound Level Meter
      vuCtx.clearRect(0, 0, vuCanvas.width, vuCanvas.height);
      const targetVu = Math.min(1, (bassSum / 6) * 1.15);
      vuLevel += (targetVu - vuLevel) * 0.3;
      if (vuLevel > vuPeak) vuPeak = vuLevel;
      else vuPeak = Math.max(0, vuPeak - 0.015);

      const segs = 16;
      const segW = (vuCanvas.width - (segs - 1) * 3) / segs;
      const litCount = Math.round(vuLevel * segs);
      const peakSeg = Math.min(segs - 1, Math.floor(vuPeak * segs));
      for (let s = 0; s < segs; s++) {
        const sx = s * (segW + 3);
        const lit = s < litCount || s === peakSeg;
        let col = '#18181b';
        if (lit) {
          col = s < 8 ? '#22c55e' : s < 12 ? '#22d3ee' : s < 14 ? '#f59e0b' : '#ff262c';
        }
        vuCtx.fillStyle = col;
        vuCtx.fillRect(sx, 4, segW, vuCanvas.height - 8);
      }

      // Subtle Speaker Cone Bass Thump Pulse
      if (wooferL && wooferR) {
        const pulse = 1 + (bassSum / 6) * 0.028;
        const glow = Math.min(0.45, (bassSum / 6) * 0.5);
        wooferL.style.transform = `scale(${pulse.toFixed(4)})`;
        wooferR.style.transform = `scale(${pulse.toFixed(4)})`;
        wooferL.style.boxShadow = `inset 0 0 24px rgba(34,211,238,${glow.toFixed(2)}), 0 0 22px rgba(34,211,238,${(glow * 0.6).toFixed(2)})`;
        wooferR.style.boxShadow = `inset 0 0 24px rgba(226,28,33,${glow.toFixed(2)}), 0 0 22px rgba(226,28,33,${(glow * 0.6).toFixed(2)})`;
      }

      rafId = requestAnimationFrame(animate);
    }

    function syncVisualizerLoop() {
      if (isPlaying && !document.hidden) {
        if (rafId === null) rafId = requestAnimationFrame(animate);
      } else {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        drawStaticIdle();
      }
    }

    document.addEventListener('visibilitychange', syncVisualizerLoop);

    // Initialize UI (0% CPU idle frame until user presses Play)
    applyVolume(85);
    updateTrackUI();
    drawStaticIdle();
  });
</script>
