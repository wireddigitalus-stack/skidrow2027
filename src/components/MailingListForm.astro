---
import { SITE } from '../data/site';
import Icons from './Icons.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section
  id="join-mailing-list"
  class:list={[
    'relative overflow-hidden border-y border-crimson/50 bg-gradient-to-br from-crimson via-[#c81419] to-[#7d0a0e]',
    compact ? 'py-10 sm:py-12' : 'py-14 sm:py-20',
  ]}
>
  <div class="rock-grain pointer-events-none absolute inset-0 opacity-45" />
  <div class="relative mx-auto max-w-4xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="font-mono-meta inline-block bg-black/80 px-3 py-1 text-[11px] tracking-[0.2em] text-chalk uppercase">
        Stay in the loop — never miss a show
      </span>
      <h2 class="font-display mt-3 text-4xl leading-none tracking-wide text-white uppercase sm:text-5xl md:text-6xl">
        Join the Skid Row Mailing List
      </h2>
      <p class="mt-3 text-sm text-white/90 sm:text-base">
        Get 2027 pre-sale ticket passwords, VIP drops, new music releases, and tour announcements first.
      </p>
    </div>

    <form
      class="sr-signup-form mx-auto mt-7 max-w-2xl border border-black/40 bg-black/85 p-5 shadow-2xl backdrop-blur-sm sm:p-7"
      data-mailerlite-url={SITE.mailerLiteUrl}
    >
      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
        <div>
          <label class="font-mono-meta mb-1.5 block text-[11px] tracking-wider text-ash uppercase">
            First Name
          </label>
          <input
            type="text"
            name="firstName"
            autocomplete="given-name"
            placeholder="First name"
            class="min-h-12 w-full border border-white/20 bg-coal px-3.5 text-sm text-white placeholder:text-ash/60 focus:border-crimson focus:outline-none"
          />
        </div>
        <div>
          <label class="font-mono-meta mb-1.5 block text-[11px] tracking-wider text-ash uppercase">
            Last Name
          </label>
          <input
            type="text"
            name="lastName"
            autocomplete="family-name"
            placeholder="Last name"
            class="min-h-12 w-full border border-white/20 bg-coal px-3.5 text-sm text-white placeholder:text-ash/60 focus:border-crimson focus:outline-none"
          />
        </div>
        <div>
          <label class="font-mono-meta mb-1.5 block text-[11px] tracking-wider text-ash uppercase">
            Email <span class="text-crimson">*</span>
          </label>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="min-h-12 w-full border border-white/20 bg-coal px-3.5 text-sm text-white placeholder:text-ash/60 focus:border-crimson focus:outline-none"
          />
        </div>
        <div>
          <label class="font-mono-meta mb-1.5 block text-[11px] tracking-wider text-ash uppercase">
            Mobile (Optional — Pre-Sale SMS)
          </label>
          <input
            type="tel"
            name="phone"
            autocomplete="tel"
            placeholder="+1 (555) 000-0000"
            class="min-h-12 w-full border border-white/20 bg-coal px-3.5 text-sm text-white placeholder:text-ash/60 focus:border-crimson focus:outline-none"
          />
        </div>
      </div>

      <label class="mt-4 flex cursor-pointer items-start gap-2.5 text-xs text-ash sm:text-sm">
        <input
          type="checkbox"
          required
          class="mt-0.5 h-4 w-4 shrink-0 accent-crimson"
        />
        <span>
          Yes, subscribe me to Skid Row news, tour pre-sale alerts, and exclusive updates.
        </span>
      </label>

      <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
        <button
          type="submit"
          class="btn-crimson w-full sm:w-auto sm:min-w-48"
        >
          <Icons name="mail" class="h-4 w-4" />
          Join the Rebellion
        </button>
        <a
          href={SITE.mailerLiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono-meta inline-flex items-center justify-center gap-1.5 text-xs text-ash underline decoration-white/30 underline-offset-4 transition-colors hover:text-white"
        >
          Open official MailerLite pre-sale form
          <Icons name="external" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div
        class="sr-signup-feedback mt-4 hidden border border-emerald-500/40 bg-emerald-950/60 px-4 py-3 text-sm text-emerald-200"
        role="status"
      ></div>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('.sr-signup-form').forEach((form) => {
    if (form.dataset.bound) return;
    form.dataset.bound = 'true';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') || '').trim();
      const firstName = String(data.get('firstName') || '').trim();
      const lastName = String(data.get('lastName') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const feedback = form.querySelector<HTMLElement>('.sr-signup-feedback');
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const mailerLiteUrl = form.dataset.mailerliteUrl || '';

      const params = new URLSearchParams(window.location.search);
      let sessionId = 'signup';
      try {
        sessionId = sessionStorage.getItem('sr_sid') || sessionId;
      } catch {}

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.65';
      }

      try {
        const res = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName,
            lastName,
            email,
            phone,
            sourcePage: window.location.pathname,
            utmSource: params.get('utm_source') || '',
            utmCampaign: params.get('utm_campaign') || '',
            sessionId,
          }),
        });
        const json = await res.json();
        if (!res.ok || !json.ok) {
          throw new Error(json.error || 'Could not save your signup.');
        }

        if (feedback) {
          feedback.className =
            'sr-signup-feedback mt-4 border border-emerald-500/40 bg-emerald-950/60 px-4 py-3 text-sm text-emerald-200';
          feedback.innerHTML = `<strong>You're on the list${firstName ? `, ${firstName}` : ''}!</strong> We registered <code>${email}</code> for 2027 pre-sale codes &amp; updates. <a href="${mailerLiteUrl}" target="_blank" rel="noopener noreferrer" class="underline font-semibold text-white">Also verify on MailerLite →</a>`;
        }
        form.reset();
      } catch (err: any) {
        if (feedback) {
          feedback.className =
            'sr-signup-feedback mt-4 border border-crimson/60 bg-crimson/20 px-4 py-3 text-sm text-white';
          feedback.textContent = err?.message || 'Unable to submit right now. Please try again.';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.style.opacity = '1';
        }
      }
    });
  });
</script>
